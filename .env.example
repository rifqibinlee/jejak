# ── Copy this file to .env and fill in your values ────────────────────────────
# Never commit the actual .env file to version control.

# Flask
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vibe_db
DB_USER=postgres
DB_PASSWORD=changeme

# AWS / Athena
AWS_REGION=ap-southeast-1
ATHENA_DATABASE=jejak-mappro-demo
S3_STAGING_DIR=s3://jejak-mappro-demo/3W-data/athena-query-results/
S3_BUCKET=jejak-mappro-demo

# AI / LiteLLM
LITELLM_API_KEY=sk-replace-this
LITELLM_API_BASE=https://gateway.ai.celcomdigi.tech/
LITELLM_MODEL=litellm_proxy/global.anthropic.claude-sonnet-4-20250514-v1:0

# Metabase (embedding)
METABASE_URL=http://localhost:3000
METABASE_SECRET_KEY=replace-with-metabase-admin-secret
METABASE_INTERNAL_URL=http://metabase:3000
METABASE_USER=your-metabase-user@email.com
METABASE_PASSWORD=your-metabase-password
